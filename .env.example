# Copy to .env and edit. Never commit .env.

# --- Dashboard (keep it on localhost) ---
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8000

# --- Your Chrome (started by: python -m tracker chrome) ---
CDP_URL=http://127.0.0.1:9222
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PROFILE_DIR=.chrome-profile

# --- Portal ---
SITE_HOST=usvisascheduling.com
SITE_LINK=https://www.usvisascheduling.com/
LOCATIONS=Mumbai,New Delhi,Chennai,Hyderabad,Kolkata

# --- Endpoint mapping (fill these in from data/discovery.jsonl; see README) ---
# Case-insensitive regexes matched against the request URL. Defaults are guesses.
# PATTERN_OFC_DAYS=ofc[-_]?schedule[-_]?days
# PATTERN_OFC_TIMES=ofc[-_]?schedule[-_]?entries
# PATTERN_INTERVIEW_DAYS=consular[-_]?schedule[-_]?days
# PATTERN_INTERVIEW_TIMES=consular[-_]?schedule[-_]?entries
# Which request field carries the location ID (regex on the field name):
# LOCATION_KEY_PATTERN=^(postid|post_id|locationid|location_id|consulateid|ofcid|post|location)$
# Map location IDs to names: id=Name;id=Name
LOCATION_MAP=
# Paths that count as an "appointment page" view (regex on URL path, not host):
# APPOINTMENT_PAGE_PATTERN=(schedule|reschedule|appointment)
# LOGIN_PAGE_PATTERN=(login|signin|sign-in|b2clogin|/identity/)

# --- Discovery mode: logs redacted request/response shapes ---
DISCOVERY_MODE=true
DISCOVERY_LOG=data/discovery.jsonl

# --- Storage ---
DB_PATH=data/tracker.db

# --- Safety: portal views per US-Eastern day before the dashboard turns red ---
DAILY_VIEW_BUDGET=12

# --- Alerts ---
ALERT_DEDUPE_HOURS=6
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

LOG_LEVEL=INFO
